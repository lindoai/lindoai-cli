{
  "name": "lindoai-cli",
  "version": "1.4.5",
  "description": "Command-line interface for the Lindo API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lindoai": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "lindoai",
    "lindo",
    "cli",
    "api",
    "command-line"
  ],
  "author": "Lindo AI <hello@lindo.ai>",
  "license": "MIT",
  "homepage": "https://lindo.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/lindoai/lindoai-cli"
  },
  "bugs": {
    "url": "https://github.com/lindoai/lindoai-cli/issues"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.0.0",
    "lindoai": "^1.1.4",
    "marked": "^17.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fast-check": "^3.23.2",
    "tsup": "^8.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
}
